# Stead keeper (reporter + relayer + housekeeping) as a long-lived service.
# Install: see deploy/README.md. Paths assume the repo at /opt/stead and a `stead` user.
[Unit]
Description=Stead keeper
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stead
WorkingDirectory=/opt/stead/stewards
# fork | sepolia (sepolia: readings come from OutLayer proofs)
Environment=STEAD_EVM=sepolia
Environment=NODE_ENV=production
ExecStart=/opt/stead/stewards/node_modules/.bin/tsx scripts/keeper.ts
Restart=always
RestartSec=5
StartLimitIntervalSec=0
StandardOutput=append:/var/log/stead/keeper.log
StandardError=append:/var/log/stead/keeper.log
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/log/stead /opt/stead/stewards/logs
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
