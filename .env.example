# Copy to .env (gitignored). Never paste real values into chat, code or docs.

# NEAR testnet
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
NEAR_MPC_CONTRACT=v1.signer-prod.testnet
NEAR_CONTRACT_ID=steadfi.testnet
NEAR_OWNER_ACCOUNT=
NEAR_CREDENTIALS_DIR=~/.near-credentials/testnet

# Local fork (Sepolia fork, chain id 31337)
FORK_UPSTREAM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
FORK_RPC_URL=http://127.0.0.1:8545
FORK_CHAIN_ID=31337
FORK_BLOCK=                  # optional: pin the fork block for reproducible runs

# Mode: "fork" (default) or "sepolia" (verified OutLayer reads)
STEAD_EVM=
SEPOLIA_RPC_URL=
STEAD_MARKET_ID=
# NEAR account that pays for verified reads (default: the reporter); must be allowed to use the proof program's OutLayer secret
VERIFY_PAYER=

# Steward EVM keys (testnet funds only) and optional risk limit per rescue, in whole LINK
STEWARD_PATIENT_EVM_KEY=
STEWARD_SWIFT_EVM_KEY=
STEWARD_DEEP_EVM_KEY=
STEWARD_POOL_EVM_KEY=
BORROWER_EVM_KEY=
STEWARD_DEEP_CAPACITY=

# Optional AI risk tuning (off when no key is set). Any OpenAI-compatible chat-completions endpoint.
# Defaults: NEAR AI Cloud (https://cloud-api.near.ai/v1), model z-ai/glm-5.3-flash.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_FALLBACK_MODEL=
# true (default): a change applies only with a valid response signature (NEAR AI Cloud provides one).
# false: any provider's answer applies, clamped to the bounds and labelled UNVERIFIED.
AI_REQUIRE_SIGNATURE=

# Optional: the hedged steward's perps venue (Orderly TESTNET only). Created by
# `cd stewards && npx tsx scripts/orderly.ts setup` (generated here, never printed).
ORDERLY_EVM_KEY=
ORDERLY_KEY_SEED=
