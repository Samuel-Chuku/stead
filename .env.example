# Copy to .env (gitignored). Never paste real values into chat, code or docs.

# NEAR testnet
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
NEAR_MPC_CONTRACT=v1.signer-prod.testnet
NEAR_CONTRACT_ID=            # pending: stead.testnet is taken (see docs/STATE.md)
NEAR_OWNER_ACCOUNT=
NEAR_CREDENTIALS_DIR=~/.near-credentials/testnet

# Local fork (Sepolia fork, chain id 31337)
FORK_UPSTREAM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
FORK_RPC_URL=http://127.0.0.1:8545
FORK_CHAIN_ID=31337
FORK_BLOCK=                  # optional: pin the fork block for reproducible runs
