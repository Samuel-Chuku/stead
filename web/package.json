{
  "name": "stead-web",
  "private": true,
  "type": "module",
  "description": "Stead front end. Runtime dependency: the ethereumjs EVM, which runs Aave's real contracts in the simulator. Vite comes from the stewards package (cd ../stewards && npm ci).",
  "scripts": {
    "dev": "../stewards/node_modules/.bin/vite --port 5173 --strictPort",
    "build": "../stewards/node_modules/.bin/vite build",
    "preview": "../stewards/node_modules/.bin/vite preview --port 4173 --strictPort"
  },
  "dependencies": {
    "@ethereumjs/block": "10.1.3",
    "@ethereumjs/common": "10.1.3",
    "@ethereumjs/statemanager": "10.1.3",
    "@ethereumjs/tx": "10.1.3",
    "@ethereumjs/util": "10.1.3",
    "@ethereumjs/vm": "10.1.3",
    "@hot-labs/near-connect": "0.12.0",
    "buffer": "6.0.3",
    "viem": "2.57.7"
  }
}
